# ------------------------------------------------------------------
# VyapaarOS environment configuration
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env` / `.env.local` — they are git-ignored.
# ------------------------------------------------------------------

# JWT signing secret — generate with: openssl rand -hex 32
# REQUIRED in production. Falls back to an insecure dev value otherwise.
JWT_SECRET=

# Token lifetime, e.g. 8h, 12h, 1d
JWT_TTL=8h

# Default admin account seeded at startup.
# Demo defaults: username "1", password "1" (override in production!)
ADMIN_USERNAME=1
ADMIN_PASSWORD=1

# Comma-separated list of additional allowed CORS origins
# (localhost on any port is always allowed in development)
ALLOWED_ORIGINS=

# Supabase (Postgres) — live persistence for branch data.
# Create the tables with database/schema.sql, then open anon access with
# database/rls.sql (run both in the Supabase SQL editor).
#   Project Settings → API → Project URL
#   Project Settings → API → anon/public key (the "publishable" or legacy JWT key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
